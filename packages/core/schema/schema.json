{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema.json",
  "title": "디자인 하네스 메인 스키마 — 객체와 관계",
  "description": "객체 하나 = $defs 하나. 데이터 파일 둘이 따른다: screens.json(project, AI) · flow.json(flowFile, AI). x-ref = id로 가리키는 관계(scripts/schema.js가 검사). 값(색 · 그림자 숫자)은 scripts/looks.js 계산과 packages/core/tokens/dress.css에만 — AI가 쓰는 객체에는 id만. x-stage = AI가 한 번에 쓰는 걸음(I 의도 · L 화면 목록 · S 화면 하나 · C 시안 · P 프리셋 · F 흐름) — 칸에 없으면 위 칸을 따르고, 맨 위까지 없으면 걸음과 상관없이 늘 본다. x-steps = schema.js --step 이름 → 그 걸음까지 채우는 x-stage. 그 밖 칸은 필수 · 관계를 보지 않는다. x-writer = 누가 쓰나(ai = AI가 판단해서 · harness = 사람이 보드에서 고른 것을 하네스가 옮겨 적거나 스크립트가 채움) — harness 칸도 형식 · 관계는 본다.",
  "x-version": "1",
  "x-steps": {
    "intent": [
      "I"
    ],
    "list": [
      "I",
      "L"
    ],
    "full": [
      "I",
      "L",
      "S",
      "C",
      "P",
      "F"
    ]
  },
  "$defs": {
    "project": {
      "type": "object",
      "required": [
        "project",
        "platform",
        "stories",
        "roles",
        "states",
        "facts",
        "preset",
        "screens"
      ],
      "description": "screens.json의 뿌리. 최상위 칸은 모두 여기 있다 — 없는 칸을 쓰면 FAIL(스키마 밖에서 손으로 쓴 칸 0). 하네스 실행 상태(고른 시안 · 색 · 꾸밈 · 잠금 · 의견 기록)는 board 하나에 모은다.",
      "properties": {
        "project": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "x-stage": "I"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "x-stage": "I"
        },
        "brand": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "description": "상단바 서비스 이름 — 없으면 title",
          "x-stage": "I"
        },
        "brandIcon": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "상단바 아이콘 lucide 이름 — 없으면 layout-dashboard",
          "x-stage": "I"
        },
        "platform": {
          "type": "string",
          "enum": [
            "web",
            "mobile"
          ],
          "x-stage": "I"
        },
        "stories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/story"
          },
          "x-stage": "I",
          "description": "PRD에서 옮긴 유저스토리 · 기능 · 조건. 화면이 story id로 가리킨다"
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/role"
          },
          "x-stage": "I"
        },
        "states": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/state"
          },
          "x-stage": "I",
          "description": "이 서비스의 상태 어휘(예: 확정 · 후보 · 바뀜)와 그 상태를 볼 수 있는 역할. 모든 화면이 이 목록 하나로 상태를 표시하고, 보이면 안 되는 역할의 화면에는 대신 문구를 쓴다"
        },
        "say": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          },
          "x-stage": "I",
          "description": "화면 말 사전 — 화면에 쓸 말 → 쓰지 않을 말(예: '알리기' → '푸시 발송')"
        },
        "facts": {
          "type": "object",
          "x-stage": "I",
          "description": "공통 사실 — 이름표: 실제 값. 사실이 사는 유일한 곳"
        },
        "preset": {
          "$ref": "#/$defs/preset",
          "x-stage": "P"
        },
        "looks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/look"
          },
          "x-stage": "P",
          "description": "PRD 맞춤 분위기(1개). preset이 있으면 screens.js가 계산하므로 비운다"
        },
        "screens": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/screen"
          },
          "x-stage": "L"
        },
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/section"
          },
          "x-stage": "L",
          "description": "사용 흐름의 큰 구역 — screen.section이 key로 가리킨다"
        },
        "concepts": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/concept"
          },
          "x-stage": "C",
          "description": "시안 10개 = 과감함 1~10단계"
        },
        "board": {
          "$ref": "#/$defs/board",
          "x-stage": "C"
        },
        "nextScreenId": {
          "type": "integer",
          "minimum": 1,
          "x-writer": "harness",
          "x-stage": "L",
          "description": "scripts/ids.js가 쓰는 다음 화면 번호"
        },
        "nextRegionId": {
          "type": "integer",
          "minimum": 101,
          "x-writer": "harness",
          "x-stage": "L",
          "description": "scripts/ids.js가 쓰는 다음 영역 번호"
        }
      },
      "additionalProperties": false
    },
    "story": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "text",
        "prd"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "목록 안에서 하나"
        },
        "kind": {
          "type": "string",
          "enum": [
            "story",
            "feature",
            "condition",
            "conflict"
          ],
          "description": "story = 유저스토리(누가 무엇을) · feature = 기능 요구 · condition = 지켜야 할 조건 · conflict = PRD가 풀라고 한 갈등"
        },
        "role": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "x-ref": "roles.key",
          "description": "story면 누구의 이야기인지(필수). feature · condition · conflict는 비워도 된다"
        },
        "text": {
          "type": "string",
          "minLength": 4,
          "description": "PRD 원문을 한 문장으로 줄인 것(뜻은 바꾸지 않는다)"
        },
        "prd": {
          "type": "string",
          "minLength": 1,
          "description": "PRD 위치(예: §2-1)"
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "label",
        "show",
        "tone",
        "icon"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "목록 안에서 하나"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12,
          "description": "화면에 보이는 말(예: 후보)"
        },
        "show": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "x-ref": "roles.key",
          "description": "이 상태를 볼 수 있는 역할"
        },
        "tone": {
          "type": "string",
          "enum": [
            "neutral",
            "primary",
            "success",
            "warning",
            "danger",
            "info"
          ],
          "description": "배지 색 — 같은 상태 = 같은 색"
        },
        "icon": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "allowlist 아이콘 lucide 이름(예: circle-dashed)"
        },
        "hide": {
          "type": "string",
          "enum": [
            "record",
            "state"
          ],
          "description": "show에 없는 역할에게 숨기는 범위. record(기본) = 그 상태의 기록 전체를 hidden 문구 한 줄로 · state = 기록 이름은 보이고 상태 자리만 hidden 문구. 어느 쪽이든 그 사람 본인의 기록은 숨기지 않는다"
        },
        "hidden": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "description": "show에 없는 역할의 화면에 대신 보일 문구(예: 정하는 중이에요). show가 모든 역할이 아니면 필수"
        },
        "means": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "이 상태가 뜻하는 것 한 줄(보드 · 정책 메모용)"
        },
        "kinds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "이 상태를 쓰는 기록 종류(예: ['할 일']). 비우면 모든 종류"
        }
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "label",
        "goal"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "goal": {
          "type": "string",
          "minLength": 4,
          "maxLength": 80,
          "description": "이 역할이 이루려는 것 한 문장"
        },
        "inclusion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "나이 · 기기 · 읽는 상황"
        },
        "type": {
          "type": "string",
          "enum": [
            "normal",
            "large"
          ],
          "description": "이 역할 화면만의 글자 크기 — inclusion에서 나온다"
        },
        "user": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20
            },
            "initials": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4
            }
          },
          "description": "셸 오른쪽 위 · 사이드바 아래에 보일 사람. 없으면 label 앞 두 글자"
        },
        "nav": {
          "type": "array",
          "x-stage": "L",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "slug",
              "label"
            ],
            "properties": {
              "slug": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$",
                "x-ref": "screens.slug"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12
              },
              "icon": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$",
                "description": "allowlist 아이콘 lucide 이름"
              }
            }
          },
          "description": "메뉴 — 화면 목록을 정할 때 채운다"
        }
      }
    },
    "preset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keywords",
        "tone",
        "brand",
        "font",
        "size",
        "density",
        "why"
      ],
      "description": "서비스 하나에 하나. AI가 PRD로 고른 판단 기록 — 값은 scripts/screens.js가 PR 27 칸으로 잇는다(tone → custom.base · brand → custom.hex · 기준어 → custom.name · font → custom.font · size → toggles.type, 계산은 looks.js customLook). 판 모양 · 그림자는 시안 꾸밈(dress.js)이 맡는다. 보드에서 사람이 바꾼다(다시 생성 없이).",
      "properties": {
        "keywords": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/keyword"
          },
          "description": "성격 — 기준어 셋"
        },
        "tone": {
          "type": "string",
          "enum": [
            "white",
            "paper",
            "tint",
            "color",
            "dark"
          ],
          "description": "바탕 톤"
        },
        "brand": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "description": "대표색 — 나머지 색 · 대비는 계산"
        },
        "font": {
          "type": "string",
          "enum": [
            "pretendard",
            "suit",
            "nanum-square-round",
            "ibm-plex",
            "serif-title"
          ],
          "x-ref": "scripts/looks.js FONTS"
        },
        "size": {
          "type": "string",
          "enum": [
            "normal",
            "large"
          ],
          "description": "본문 KRDS 17 · 크게 19"
        },
        "density": {
          "type": "string",
          "enum": [
            "compact",
            "normal",
            "airy"
          ]
        },
        "why": {
          "type": "array",
          "minItems": 3,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/why"
          }
        }
      }
    },
    "keyword": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "word",
        "not",
        "from"
      ],
      "properties": {
        "word": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10
        },
        "not": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10,
          "description": "하지만 이것은 아님"
        },
        "from": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "x-ref": "roles.key 또는 facts 이름표"
        }
      }
    },
    "why": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pick",
        "keyword",
        "text"
      ],
      "properties": {
        "pick": {
          "type": "string",
          "enum": [
            "tone",
            "brand",
            "font",
            "size",
            "density"
          ]
        },
        "keyword": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2,
          "x-ref": "preset.keywords 번호"
        },
        "text": {
          "type": "string",
          "minLength": 4,
          "maxLength": 60
        }
      }
    },
    "screen": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug",
        "name",
        "role",
        "pattern",
        "goal",
        "problem",
        "answer",
        "rest",
        "later"
      ],
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "x-stage": "L"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30,
          "x-stage": "L"
        },
        "role": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "x-ref": "roles.key",
          "x-stage": "L"
        },
        "story": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "x-ref": "stories.id",
          "description": "이 화면이 푸는 유저스토리 · 기능",
          "x-stage": "L"
        },
        "pattern": {
          "type": "string",
          "enum": [
            "입력폼",
            "목록 탐색",
            "상세 정보 확인",
            "확인",
            "오류",
            "도움",
            "동의",
            "필터링·정렬",
            "사용자 피드백",
            "첨부파일",
            "개인 식별 정보 입력",
            "방문",
            "검색",
            "로그인",
            "신청",
            "정책 정보 확인",
            "처음 시작"
          ],
          "x-ref": "KRDS 패턴 이름",
          "x-stage": "L"
        },
        "goal": {
          "type": "string",
          "minLength": 4,
          "maxLength": 60,
          "description": "이 화면에서 이루는 것",
          "x-stage": "S"
        },
        "problem": {
          "type": "string",
          "minLength": 4,
          "maxLength": 80,
          "description": "이 화면에서 겪는 문제",
          "x-stage": "S"
        },
        "answer": {
          "$ref": "#/$defs/answer",
          "x-stage": "S"
        },
        "rest": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/block"
          },
          "description": "같은 등급 · 배열 = 읽는 순서",
          "x-stage": "S"
        },
        "later": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/later"
          },
          "x-stage": "S"
        },
        "action": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label"
          ],
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16,
              "description": "주 버튼 하나의 글"
            }
          },
          "description": "주 버튼 — 흐름이 region 'action'으로 가리킨다",
          "x-stage": "S"
        },
        "id": {
          "type": "integer",
          "x-stage": "L"
        },
        "file": {
          "type": "string",
          "x-stage": "L"
        },
        "state": {
          "type": "string",
          "x-stage": "L"
        },
        "when": {
          "type": "string",
          "x-stage": "L"
        },
        "variantOf": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "x-stage": "L"
        },
        "overlayOf": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "x-stage": "L"
        },
        "navActive": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "x-stage": "L"
        },
        "section": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "x-stage": "L"
        },
        "step": {
          "type": "string",
          "x-stage": "L"
        },
        "policy": {
          "type": "array",
          "x-stage": "S"
        },
        "cases": {
          "type": "array",
          "x-stage": "S"
        },
        "motion": {
          "type": "array",
          "x-stage": "S"
        },
        "dark": {
          "type": "boolean",
          "x-stage": "S"
        }
      }
    },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "label",
        "why",
        "say",
        "form",
        "items",
        "facts"
      ],
      "description": "1순위 블록 — 화면에 하나(구조로 보장)",
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "화면 안에서 하나 — 조각의 data-region"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "description": "사용자에게 보이는 이름"
        },
        "why": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "왜 있나 · 어떻게 동작하나 — 화면에 그대로 나오지 않는다"
        },
        "form": {
